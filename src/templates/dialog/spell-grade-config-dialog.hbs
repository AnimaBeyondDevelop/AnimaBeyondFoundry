<form class="abf-spell-grade-config">
  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.intRequired.title"}}</label>
    <input type="number" name="intRequired" value="{{intRequired}}" step="1" />
  </div>

  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.zeon.title"}}</label>
    <input type="number" name="zeon" value="{{zeon}}" step="1" />
  </div>

  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.maintenanceCost.title"}}</label>
    <input type="text" name="maintenanceCost" value="{{maintenanceCost}}" />
  </div>

  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.area.title"}}</label>
    <input type="text" name="area" value="{{area}}" />
  </div>

  {{#if isAttack}}
  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.damage.title"}}</label>
    <input type="number" name="damage" value="{{damage}}" step="1" />
  </div>

  <div class="form-group">
    <label>{{localize "anima.ui.combat.weapons.reducedArmor.final.title"}}</label>
    <input type="number" name="reducedArmor" value="{{reducedArmor}}" step="1" />
  </div>

  <div class="form-group">
    <label>{{localize "macros.combat.dialog.critBonus.title"}}</label>
    <input type="number" name="critBonus" value="{{critBonus}}" step="1" />
  </div>

  <div class="form-group">
    <label>{{localize "macros.combat.dialog.automaticCrit.title"}}</label>
    <input type="checkbox" name="automaticCrit" {{checked automaticCrit}} />
  </div>
  {{/if}}

  {{#if isDefense}}
  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.shieldPoints.title"}}</label>
    <input type="number" name="shieldPoints" value="{{shieldPoints}}" step="1" />
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "anima.ui.mystic.spell.grade.description.title"}}</label>
    <input type="text" name="description" value="{{description}}" />
  </div>

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fas fa-save"></i>
      {{localize "dialogs.save"}}
    </button>
  </footer>
</form>
